{
  "schemaVersion": 1,
  "capabilities": [
    {
      "id": "doctor-environment",
      "status": "shipped",
      "entrypoint": "src/ghidra_skill/doctor.py",
      "cliCommands": [
        "doctor"
      ],
      "inputs": [
        "--ghidra-home DIR",
        "host PATH / known install dirs"
      ],
      "outputs": [
        "dependency report with per-tool status, impact, official URL, per-OS install commands, post-install check",
        "dynamic_ready flag"
      ],
      "safetyTier": "static-read",
      "limitations": [
        "reports availability only; never installs or mutates the system"
      ],
      "tests": [
        "tests/test_cli.py::test_doctor_envelope",
        "tests/test_install_guidance.py::test_missing_ghidra_guidance"
      ]
    },
    {
      "id": "workspace-init",
      "status": "shipped",
      "entrypoint": "src/ghidra_skill/workspace.py",
      "cliCommands": [
        "init"
      ],
      "inputs": [
        "BINARY path",
        "--target ID",
        "--scope full|symbols|addresses",
        "--entry VALUE"
      ],
      "outputs": [
        "targets/<id>/projects/",
        "artifacts/<id>/{state.json,intake/,baseline/,evidence/,metadata/,decompilation/,runtime/,scripts/,reports/,gates/}"
      ],
      "safetyTier": "static-read",
      "limitations": [
        "computes SHA-256 and format via native inspection; does not run Ghidra"
      ],
      "tests": [
        "tests/test_cli.py::test_init_creates_workspace",
        "tests/test_artifacts.py::test_state_schema"
      ]
    },
    {
      "id": "config-scope",
      "status": "shipped",
      "entrypoint": "src/ghidra_skill/workspace.py",
      "cliCommands": [
        "config scope show",
        "config scope set",
        "config scope add",
        "config scope remove"
      ],
      "inputs": [
        "--target ID",
        "scope mode / entries"
      ],
      "outputs": [
        "state.json scope.mode + scope.entries"
      ],
      "safetyTier": "static-read",
      "limitations": [
        "absorbs the historical scope (P0.5) sub-skill; no separate scope command"
      ],
      "tests": [
        "tests/test_cli.py::test_config_scope_roundtrip"
      ]
    },
    {
